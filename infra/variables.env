# =========================================================================
# Pick'Os · Easy HR — Variables de entorno para los scripts de infraestructura
# Copia/edita este archivo y luego en Cloud Shell:  source variables.env
# Corre los scripts en orden: 00 -> 08
# =========================================================================

# --- Proyecto / región (elige una región barata y cercana, p.ej. us-central1) ---
export PROJECT_ID="pickos-easyhr-dev"          # <-- CAMBIA por tu Project ID real
export REGION="us-central1"
export ZONE="us-central1-a"

# --- Red ---
export NETWORK_NAME="easyhr-vpc"
export SUBNET_NAME="easyhr-subnet"
export SUBNET_RANGE="10.10.0.0/24"
export PSA_RANGE_NAME="easyhr-psa-range"       # rango privado para Cloud SQL (Private Service Access)
export PSA_RANGE="10.20.0.0/24"
export VPC_CONNECTOR_NAME="easyhr-connector"
export VPC_CONNECTOR_RANGE="10.30.0.0/28"      # /28 obligatorio para Serverless VPC Access

# --- Cloud SQL (Postgres, tier compartido = más barato para un ambiente de prueba) ---
export SQL_INSTANCE_NAME="easyhr-sql"
export SQL_TIER="db-f1-micro"                  # revisa disponibilidad con: gcloud sql tiers list --project=$PROJECT_ID
export SQL_DB_VERSION="POSTGRES_15"
export SQL_STORAGE_SIZE="10"                   # GB, HDD (más barato que SSD)
export SQL_STORAGE_TYPE="HDD"
export DB_NAME="easyhr"
export DB_APP_USER="easyhr_app"

# --- Secret Manager ---
export SECRET_DB_PASSWORD="easyhr-db-password"
export SECRET_DB_CONN_NAME="easyhr-db-connection-name"

# --- Artifact Registry ---
export AR_REPO_NAME="easyhr-repo"
export AR_FORMAT="docker"

# --- Cloud Storage (nombres deben ser únicos globalmente, ajústalos) ---
export BUCKET_CARDS="${PROJECT_ID}-birthday-cards"
export BUCKET_JOBDESC_REFS="${PROJECT_ID}-jobdesc-references"

# --- Cuentas de servicio (una por servicio, mínimo privilegio) ---
export SA_FRONTEND="easyhr-frontend-sa"
export SA_AGENT_MASTER="easyhr-agent-master-sa"
export SA_BIRTHDAY="easyhr-birthday-agent-sa"
export SA_VACATION="easyhr-vacation-agent-sa"
export SA_JOBDESC="easyhr-jobdesc-agent-sa"
export SA_EMPLOYEE_API="easyhr-employee-api-sa"

# --- Cloud Run (nombres de servicio) ---
export CR_FRONTEND="easyhr-frontend"
export CR_AGENT_MASTER="easyhr-agent-master"
export CR_BIRTHDAY="easyhr-birthday-agent"
export CR_VACATION="easyhr-vacation-agent"
export CR_JOBDESC="easyhr-jobdesc-agent"
export CR_EMPLOYEE_API="easyhr-employee-api"

# --- CI/CD (GitHub) ---
export GITHUB_OWNER="tu-usuario-o-org"
export GITHUB_REPO="pickos-easyhr"
export GITHUB_BRANCH="^main$"

# --- Vertex AI / Gemini (usamos Vertex AI con Service Account, SIN API keys en código) ---
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"
export GEMINI_MODEL="gemini-2.5-flash"
